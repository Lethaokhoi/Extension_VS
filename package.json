{
  "name": "hsg-test-gen",
  "displayName": "HSG Sinh test",
  "description": "Sinh test HSG: AI tạo gen + brute từ đề, rồi sinh file .in / .out chuẩn.",
  "version": "0.3.0",
  "publisher": "Lethaokhoi",
  "author": {
    "name": "Khôi Chu Tuấn"
  },
  "license": "MIT",
  "homepage": "https://github.com/Lethaokhoi/Extension_VS#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lethaokhoi/Extension_VS.git"
  },
  "bugs": {
    "url": "https://github.com/Lethaokhoi/Extension_VS/issues"
  },
  "galleryBannerColor": "#1a3a52",
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "hsg",
    "olympic",
    "competitive programming",
    "test generator",
    "brute force",
    "cpp",
    "vietnam",
    "sinh test",
    "lập trình"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hsg.initWorkspace",
        "title": "HSG: Khởi tạo gen.cpp + brute.cpp + tests"
      },
      {
        "command": "hsg.generateTests",
        "title": "HSG: Sinh test (gen → .in, brute → .out)"
      },
      {
        "command": "hsg.configureApiKey",
        "title": "HSG: Cấu hình API key (AI)"
      },
      {
        "command": "hsg.generateCodeAi",
        "title": "HSG: AI tạo gen.cpp + brute.cpp từ đề bài"
      }
    ],
    "configuration": {
      "title": "HSG Sinh test",
      "properties": {
        "hsg.cppCompiler": {
          "type": "string",
          "default": "g++",
          "description": "Trình biên dịch C++"
        },
        "hsg.cppFlags": {
          "type": "string",
          "default": "-O2 -std=c++17",
          "description": "Cờ biên dịch gen.cpp"
        },
        "hsg.bruteCppFlags": {
          "type": "string",
          "default": "-O2 -std=c++17",
          "description": "Cờ biên dịch brute.cpp (code trâu)"
        },
        "hsg.python": {
          "type": "string",
          "default": "python",
          "description": "Lệnh Python (nếu dùng .py)"
        },
        "hsg.testFolder": {
          "type": "string",
          "default": "tests",
          "description": "Thư mục lưu .in / .out"
        },
        "hsg.generatorFile": {
          "type": "string",
          "default": "gen.cpp",
          "description": "Chương trình sinh input (in ra stdout)"
        },
        "hsg.bruteFile": {
          "type": "string",
          "default": "brute.cpp",
          "description": "Code trâu — đọc input stdin, in đáp án đúng ra stdout"
        },
        "hsg.defaultTestCount": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 1000,
          "description": "Số test mặc định mỗi lần sinh"
        },
        "hsg.genTimeLimitMs": {
          "type": "number",
          "default": 3000,
          "minimum": 100,
          "description": "Giới hạn thời gian chạy gen (ms)"
        },
        "hsg.bruteTimeLimitMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "Giới hạn thời gian chạy brute (ms) — code trâu thường chậm"
        },
        "hsg.language": {
          "type": "string",
          "enum": ["cpp", "python"],
          "default": "cpp",
          "description": "Ngôn ngữ gen và brute"
        },
        "hsg.ai.endpoint": {
          "type": "string",
          "default": "https://api.openai.com/v1/chat/completions",
          "description": "URL API (OpenAI hoặc tương thích: OpenRouter, Groq, …)"
        },
        "hsg.ai.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Tên model (vd gpt-4o-mini, gpt-4o)"
        },
        "hsg.ai.maxTokens": {
          "type": "number",
          "default": 8000,
          "minimum": 500,
          "maximum": 128000,
          "description": "Giới hạn token phản hồi AI"
        },
        "hsg.ai.problemFile": {
          "type": "string",
          "default": "",
          "description": "File đề ưu tiên (vd de.txt). Để trống = tự tìm de.txt, problem.md…"
        },
        "hsg.ai.includeMainCode": {
          "type": "boolean",
          "default": true,
          "description": "Gửi kèm main.cpp cho AI tham khảo khi sinh brute"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
